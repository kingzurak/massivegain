# Supabase (Milestone 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used by the Paystack routes
# to record payments (bypasses Row Level Security).
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (Milestone 4) — SERVER ONLY. Use your TEST secret key (sk_test_...)
# until you are ready to go live.
PAYSTACK_SECRET_KEY=

# Your site's public address, used for Paystack's return link.
# Local: http://localhost:3000   Live: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (Milestone 9) — SERVER ONLY. Used for rate limiting.
# Upstash dashboard → your database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
